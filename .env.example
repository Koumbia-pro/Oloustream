# Copier ce fichier en ".env" à la racine du projet et remplir les valeurs.
# Le fichier .env ne doit JAMAIS être commité.

# "production" sur le serveur O2Switch, vide en local
DJANGO_ENV=production

# Clé secrète longue et aléatoire. Générer avec :
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# En local uniquement : DJANGO_DEBUG=True (ignoré en production)
DJANGO_DEBUG=False

DJANGO_ALLOWED_HOSTS=oloustream.com,www.oloustream.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://oloustream.com,https://www.oloustream.com

# Base MySQL (production)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Email (mot de passe d'application Gmail ou SMTP O2Switch)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Oloustream <info@oloustream.com>
ADMIN_EMAIL=info@oloustream.com
SITE_URL=https://oloustream.com
